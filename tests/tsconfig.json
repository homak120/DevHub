{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "../out/tests",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["mocha", "node", "sinon"],
    "baseUrl": ".",
    "paths": {
      "vscode": ["./__mocks__/vscode"]
    }
  },
  "include": ["./**/*", "../src/**/*"]
}
